---
import BottomNavigationBar from "../components/BottomNavigationBar.astro";
import { useSeo, type UseSeoInput } from "../lib/seo";

import "../styles/global.css";

const localPath = (language = Astro.currentLocale) =>
	`/${language}/${Astro.originPathname.slice(4)}`;

const { seo: seoInput } = Astro.props as { seo?: UseSeoInput };
const seo = useSeo({
	locale: Astro.currentLocale ?? undefined,
	url: Astro.url,
	...seoInput,
});

const t = Astro.locals.json;
---

<!doctype html>
<html lang={seo.lang} dir={seo.dir} data-theme="light" class="w-dvw h-dvh">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="theme-color" content="#ffffff" />
		<meta name="generator" content={Astro.generator} />
		<title>{seo.title}</title>
		<Fragment set:html={seo.head} />
		<Fragment set:html={seo.jsonLd} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&family=Vazirmatn:wght@100..900&display=swap"
			rel="stylesheet"
		/>

		<script is:inline>
			// Apply the persisted theme before paint to avoid a light-mode flash.
			try {
				var theme = localStorage.getItem("theme");
				if (theme === "dark" || theme === "light") {
					document.documentElement.setAttribute("data-theme", theme);
				}
			} catch (e) {}
		</script>
		<script src="/script.js" is:inline></script>

		<!-- Service worker: production only, so `astro dev` stays unaffected. -->
		<script>
			if (import.meta.env.PROD && "serviceWorker" in navigator) {
				window.addEventListener("load", () => {
					navigator.serviceWorker.register("/sw.js").catch(() => {});
				});
			}
		</script>
	</head>
	<body class={`font-${Astro.currentLocale}`}>
		<a
			href="#main-content"
			class="btn btn-neutral fixed top-2 left-2 z-50 sr-only focus:not-sr-only"
		>
			{t["layout.skipToContent"]}
		</a>

		<header
			class="w-screen h-10 fixed top-0 left-0 right-0 bg-linear-to-b from-base-100 to-base-100/0"
		>
			<nav
				class="flex flex-nowrap items-center gap-1 px-2 h-full w-full md:container md:mx-auto"
				aria-label={t["layout.primaryNav"]}
			>
				<div class="flex-1"></div>
				<!-- change language -->
				<button
					class="btn btn-ghost btn-circle btn-sm"
					popovertarget="language"
					style="anchor-name:--language"
					aria-label={t["layout.changeLanguage"]}
					aria-haspopup="menu"
					aria-expanded="false"
				>
					{Astro.currentLocale?.toUpperCase()}
				</button>
				<ul
					class="dropdown dropdown-end menu w-52 rounded-lg bg-base-100 shadow-sm"
					popover
					id="language"
					style="position-anchor:--language"
					dir="ltr"
				>
					<li>
					<a href={localPath("fa")} lang="fa" hreflang="fa">
							<strong class="text-xs mr-2">FA</strong>
							<span>Persian</span>
						</a>
					</li>
					<li>
					<a href={localPath("en")} lang="en" hreflang="en">
							<strong class="text-xs mr-2">EN</strong>
							<span>English</span>
						</a>
					</li>
				</ul>

				<!-- theme switcher -->
				<label
					class="swap swap-rotate fill-base-content tooltip tooltip-bottom btn btn-ghost btn-circle btn-sm"
					data-tip={t["layout.changeTheme"]}
				>
					<span class="sr-only">{t["layout.changeTheme"]}</span>
					<!-- this hidden checkbox controls the state -->
					<input
						type="checkbox"
						class="theme-controller"
						value="dark"
						aria-label={t["layout.changeTheme"]}
					/>

					<!-- sun icon -->
					<svg
						class="swap-off"
						xmlns="http://www.w3.org/2000/svg"
						height="20px"
						viewBox="0 -960 960 960"
						width="20px"
						aria-hidden="true"
						><path
							d="M338.5-338.5Q280-397 280-480t58.5-141.5Q397-680 480-680t141.5 58.5Q680-563 680-480t-58.5 141.5Q563-280 480-280t-141.5-58.5ZM80-440q-17 0-28.5-11.5T40-480q0-17 11.5-28.5T80-520h80q17 0 28.5 11.5T200-480q0 17-11.5 28.5T160-440H80Zm720 0q-17 0-28.5-11.5T760-480q0-17 11.5-28.5T800-520h80q17 0 28.5 11.5T920-480q0 17-11.5 28.5T880-440h-80ZM451.5-771.5Q440-783 440-800v-80q0-17 11.5-28.5T480-920q17 0 28.5 11.5T520-880v80q0 17-11.5 28.5T480-760q-17 0-28.5-11.5Zm0 720Q440-63 440-80v-80q0-17 11.5-28.5T480-200q17 0 28.5 11.5T520-160v80q0 17-11.5 28.5T480-40q-17 0-28.5-11.5ZM226-678l-43-42q-12-11-11.5-28t11.5-29q12-12 29-12t28 12l42 43q11 12 11 28t-11 28q-11 12-27.5 11.5T226-678Zm494 495-42-43q-11-12-11-28.5t11-27.5q11-12 27.5-11.5T734-282l43 42q12 11 11.5 28T777-183q-12 12-29 12t-28-12Zm-42-495q-12-11-11.5-27.5T678-734l42-43q11-12 28-11.5t29 11.5q12 12 12 29t-12 28l-43 42q-12 11-28 11t-28-11ZM183-183q-12-12-12-29t12-28l43-42q12-11 28.5-11t27.5 11q12 11 11.5 27.5T282-226l-42 43q-11 12-28 11.5T183-183Z"
						></path></svg
					>

					<!-- moon icon -->
					<svg
						class="swap-on"
						xmlns="http://www.w3.org/2000/svg"
						height="20px"
						viewBox="0 -960 960 960"
						width="20px"
						aria-hidden="true"
						><path
							d="M480-120q-151 0-255.5-104.5T120-480q0-138 90-239.5T440-838q13-2 23 3.5t16 14.5q6 9 6.5 21t-7.5 23q-17 26-25.5 55t-8.5 61q0 90 63 153t153 63q31 0 61.5-9t54.5-25q11-7 22.5-6.5T819-479q10 5 15.5 15t3.5 24q-14 138-117.5 229T480-120Z"
						></path></svg
					>
				</label>
			</nav>
		</header>

		<main id="main-content" class="flex-1 pt-10">
			<slot />
		</main>

		<BottomNavigationBar />
	</body>
</html>
