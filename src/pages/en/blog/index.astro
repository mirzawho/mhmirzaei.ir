---
import ArticleCard from "../../../components/ArticleCard.astro";
import Layout from "../../../layouts/Layout.astro";
import { MirzaContent, type IContentBlog } from "../../../lib/content";

const blog = new MirzaContent<IContentBlog>("blog");
const posts = await blog.posts("en");
---

<Layout
	seo={{
		title: "My articles",
		description:
			"Articles and notes by Mohammad Hossein Mirzaei on software engineering.",
		breadcrumbs: [
			{ name: "Home", url: "/en" },
			{ name: "Blog", url: "/en/blog" },
		],
		alternates: [
			{ locale: "en", url: "/en/blog" },
			{ locale: "fa", url: "/fa/blog" },
		],
	}}
>
    <section class="flex flex-col gap-4 contained mx-auto mt-[10svh]">
        <div class="flex flex-col gap-2 mb-4">
            <h1 class="text-2xl font-bold">My articles</h1>
        </div>

        {posts.map((post) => <ArticleCard post={post} />)}
    </section>
</Layout>
