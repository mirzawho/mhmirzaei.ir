---
import ProjectCard from "../../../components/ProjectCard.astro";
import Layout from "../../../layouts/Layout.astro";

import { MirzaContent, type IContentProject } from "../../../lib/content";

const content = new MirzaContent<IContentProject>("project");
const posts = await content.posts("en");
---

<Layout
	seo={{
		title: "My projects",
		description: "Projects and products by Mohammad Hossein Mirzaei.",
		breadcrumbs: [
			{ name: "Home", url: "/en" },
			{ name: "Projects", url: "/en/project" },
		],
		alternates: [
			{ locale: "en", url: "/en/project" },
			{ locale: "fa", url: "/fa/project" },
		],
	}}
>
	<section class="flex flex-col gap-4 contained mx-auto mt-[10svh]">
		<div class="flex flex-col gap-2 mb-4">
			<h1 class="text-2xl font-bold">My projects</h1>
		</div>

		{posts.map((post) => <ProjectCard post={post} />)}
	</section>
</Layout>
