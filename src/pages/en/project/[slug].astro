---
import Layout from "../../../layouts/Layout.astro";
import {
    MirzaContent,
    PROJECT_STATUS_COLORS,
    PROJECT_STATUS_LABELS,
    type IContentProject,
} from "../../../lib/content";

const project = new MirzaContent<IContentProject>("project");

export async function getStaticPaths() {
    const slugs = await new MirzaContent<IContentProject>("project").slugs(
        "en",
    );
    return slugs.map((slug) => ({ params: { slug } }));
}

const slug = Array.isArray(Astro.params.slug)
    ? Astro.params.slug.join("/")
    : Astro.params.slug;

if (!slug) {
    return Astro.redirect("/en/project");
}

const post = await project.post("en", slug);

if (!post || !post.content) {
    return Astro.redirect("/en/project");
}

const { content: Content } = post;

const statusText = PROJECT_STATUS_LABELS[post.status]?.["en"] ?? post.status;
const statusColor = PROJECT_STATUS_COLORS[post.status] ?? "badge-ghost";
---

<Layout
    seo={{
        title: post.title,
        description: post.description,
        type: "article",
        image: post.thumbnail,
        imageAlt: post.title,
        author: { name: post.author },
        publishedAt: post.publishedAt,
        section: post.category,
        tags: post.tags,
        breadcrumbs: [
            { name: "Home", url: "/en" },
            { name: "Projects", url: "/en/project" },
            { name: post.title, url: `/en/project/${post.slug}` },
        ],
        alternates: [
            { locale: "en", url: `/en/project/${post.slug}` },
            { locale: "fa", url: `/fa/project/${post.slug}` },
        ],
    }}
>
    <article class="flex flex-col gap-2 contained mx-auto sm:mt-[10svh]">
        <div class="flex flex-col p-2">
            <div class="flex flex-nowrap items-center gap-2">
                {
                    post.favicon && (
                        <img
                            src={post.favicon}
                            alt={`${post.title} favicon`}
                            class="size-8 rounded object-center object-cover"
                        />
                    )
                }
                <h1 class="text-2xl font-bold">{post.title}</h1>
            </div>
            <div class="flex flex-wrap gap-2 text-xs mt-2">
                <p class="flex flex-nowrap items-center gap-1">
                    <!-- today icon -->
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        height="16px"
                        viewBox="0 -960 960 960"
                        width="16px"
                        aria-hidden="true"
                    >
                        <path
                            d="M509-269q-29-29-29-71t29-71q29-29 71-29t71 29q29 29 29 71t-29 71q-29 29-71 29t-71-29ZM200-80q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-40q0-17 11.5-28.5T280-880q17 0 28.5 11.5T320-840v40h320v-40q0-17 11.5-28.5T680-880q17 0 28.5 11.5T720-840v40h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T760-80H200Zm0-80h560v-400H200v400Z"
                        ></path>
                    </svg>

                    <time datetime={post.publishedAt.toISOString()}>
                        {post.publishedAt.toLocaleDateString("en")}
                    </time>
                </p>
                {
                    post.category && (
                        <p class="flex flex-nowrap items-center gap-2">
                            <span
                                class="size-1 bg-base-content/30 rounded-full"
                                aria-hidden="true"
                            />
                            <span>{post.category}</span>
                        </p>
                    )
                }
                <span
                    class="size-1 bg-base-content/30 my-auto rounded-full"
                    aria-hidden="true"></span>
                <p>Mohammad Hossein Mirzaei</p>
            </div>
        </div>

        <p class="text-base-content/70 px-2">{post.description}</p>

        <div class="flex flex-wrap gap-1 p-2">
            {
                post.technologies.map((item) => (
                    <p
                        dir="ltr"
                        class="badge badge-ghost bg-base-300 fill-base-content text-base-content text-xs font-bold"
                    >
                        {item.image && (
                            <img
                                src={item.image}
                                alt=""
                                class="size-4 object-contain"
                            />
                        )}
                        <span>{item.text}</span>
                    </p>
                ))
            }

            {
                post.members && (
                    <p class="badge badge-ghost bg-base-300 fill-base-content text-base-content text-xs font-bold">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            height="20px"
                            width="20px"
                            viewBox="0 -960 960 960"
                        >
                            <path d="M84-264q-15 0-25.5-10.5T48-300v-21q0-39 39-63t105-24q14 0 26 1t23 3q-12 18-18.5 39.11Q216-343.77 216-322v58H84Zm216 0q-15 0-25.5-10.5T264-300v-22q0-28 14.5-50t43.5-39q29-17 69-25t89.5-8q49.5 0 89 8t68.5 25q29 16 43.5 38.69Q696-349.62 696-322v22q0 15-10.5 25.5T660-264H300Zm444 0v-58q0-22-6.5-42.5T719-404q9-2 20.5-3t28.5-1q66 0 105 24t39 63v21q0 15-10.5 25.5T876-264H744ZM192-456q-30 0-51-21t-21-51q0-30 21-51t51-21q30 0 51 21t21 51q0 30-21 51t-51 21Zm576 0q-30 0-51-21t-21-51q0-30 21-51t51-21q30 0 51 21t21 51q0 30-21 51t-51 21Zm-288-36q-45 0-76.5-31.52T372-600.07q0-44.93 31.52-76.43 31.52-31.5 76.55-31.5 44.93 0 76.43 31.55Q588-644.9 588-600q0 45-31.55 76.5T480-492Z" />
                        </svg>
                        <span>{post.members} team members</span>
                    </p>
                )
            }

            {
                (post.start_at || post.end_at) && (
                    <p class="badge badge-ghost bg-base-300 fill-base-content text-base-content text-xs font-bold">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            height="16px"
                            viewBox="0 -960 960 960"
                            width="16px"
                            aria-hidden="true"
                        >
                            <path d="M509-269q-29-29-29-71t29-71q29-29 71-29t71 29q29 29 29 71t-29 71q-29 29-71 29t-71-29ZM200-80q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-40q0-17 11.5-28.5T280-880q17 0 28.5 11.5T320-840v40h320v-40q0-17 11.5-28.5T680-880q17 0 28.5 11.5T720-840v40h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T760-80H200Zm0-80h560v-400H200v400Z" />
                        </svg>

                        {post.start_at && (
                            <time datetime={post.start_at}>
                                {post.start_at}
                            </time>
                        )}
                        {post.end_at && (
                            <time datetime={post.end_at}>
                                {post.end_at}
                            </time>
                        )}
                    </p>
                )
            }

            {
                post.status && (
                    <p class={`badge ${statusColor} text-xs font-bold`}>
                        <span>{statusText}</span>
                    </p>
                )
            }
        </div>

        {
            post.thumbnail && (
                <img src={post.thumbnail} alt="" class="w-full rounded-xl" />
            )
        }

        <div class="prose p-2">
            <Content />
        </div>

        <div class="flex flex-wrap gap-2 text-sm text-base-content/70 p-2">
            {
                post.tags.length > 0 &&
                    post.tags.map((tag) => (
                        <span>#{tag.split(" ").join("_")}</span>
                    ))
            }
        </div>
    </article>
</Layout>
