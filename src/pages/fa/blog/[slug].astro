---
import Layout from "../../../layouts/Layout.astro";
import blog from "../../../lib/blog";

export async function getStaticPaths() {
    const slugs = await blog.slugs("fa");
    return slugs.map((slug) => ({ params: { slug } }));
}

const slug = Array.isArray(Astro.params.slug)
    ? Astro.params.slug.join("/")
    : Astro.params.slug;

if (!slug) {
    return Astro.redirect("/fa/blog");
}

const post = await blog.post("fa", slug);

if (!post || !post.content) {
    return Astro.redirect("/fa/blog");
}

const { content: Content } = post;
---

<Layout
	seo={{
		title: post.title,
		description: post.description,
		type: "article",
		image: post.thumbnail,
		imageAlt: post.title,
		author: { name: post.author },
		publishedAt: post.publishedAt,
		section: post.category,
		tags: post.tags,
		breadcrumbs: [
			{ name: "خانه", url: "/fa" },
			{ name: "وبلاگ", url: "/fa/blog" },
			{ name: post.title, url: `/fa/blog/${post.slug}` },
		],
		alternates: [
			{ locale: "fa", url: `/fa/blog/${post.slug}` },
			{ locale: "en", url: `/en/blog/${post.slug}` },
		],
	}}
>
    <article class="flex flex-col gap-4 contained mx-auto sm:mt-[10svh]">
        <div class="flex flex-col p-2">
            <h1 class="text-2xl font-bold">{post.title}</h1>
            <div class="flex flex-wrap gap-2 text-xs mt-2">
                <p class="flex flex-nowrap items-center gap-1">
                    <!-- today icon -->
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        height="16px"
                        viewBox="0 -960 960 960"
                        width="16px"
                        aria-hidden="true"
                    >
                        <path
                            d="M509-269q-29-29-29-71t29-71q29-29 71-29t71 29q29 29 29 71t-29 71q-29 29-71 29t-71-29ZM200-80q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-40q0-17 11.5-28.5T280-880q17 0 28.5 11.5T320-840v40h320v-40q0-17 11.5-28.5T680-880q17 0 28.5 11.5T720-840v40h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T760-80H200Zm0-80h560v-400H200v400Z"
                        ></path>
                    </svg>

                    <time datetime={post.publishedAt.toISOString()}>
                        {post.publishedAt.toLocaleDateString("fa")}
                    </time>
                </p>
                {
                    post.category && (
                        <p class="flex flex-nowrap items-center gap-2">
                            <span class="size-1 bg-base-content/30 rounded-full" aria-hidden="true"></span>
                            <span>{post.category}</span>
                        </p>
                    )
                }
                <span class="size-1 bg-base-content/30 my-auto rounded-full" aria-hidden="true"></span>
                <p>محمد حسین میرزایی</p>
            </div>
        </div>

        {
            post.thumbnail && (
                <img
                    src={post.thumbnail}
                    alt=""
                    class="w-full rounded-xl"
                />
            )
        }

        <div class="prose p-2">
            <Content />
        </div>

        <div class="flex flex-wrap gap-2 text-sm text-base-content/70 p-2">
            {
                post.tags.length > 0 &&
                    post.tags.map((tag) => (
                        <span>#{tag.split(" ").join("_")}</span>
                    ))
            }
        </div>
    </article>
</Layout>
