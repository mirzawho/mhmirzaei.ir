---
import type { IBlogPost } from "../lib/blog";

interface Props {
    post: IBlogPost;
}

const { post } = Astro.props;
const locale = Astro.currentLocale ?? "en";
---

<article class="flex flex-col gap-4">
    {
        post.thumbnail && (
            <a href={`/${locale}/blog/${post.slug}`}>
                <img
                    src={post.thumbnail}
                    alt={post.title}
                    class="w-full rounded-xl"
                />
            </a>
        )
    }

    <div class="flex flex-col gap-1 px-2">
        <a href={`/${locale}/blog/${post.slug}`} class="hover:text-primary">
            <h2 class="text-xl font-bold">{post.title}</h2>
        </a>

        <p class="text-base-content/70">{post.description}</p>

        <div class="flex flex-wrap gap-2 mt-2">
            <time
                class="badge badge-ghost bg-base-300 fill-base-content text-base-content text-xs transition-all hover:text-primary hover:fill-primary"
            >
                <!-- today icon -->
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    height="16px"
                    viewBox="0 -960 960 960"
                    width="16px"
                >
                    <path
                        d="M509-269q-29-29-29-71t29-71q29-29 71-29t71 29q29 29 29 71t-29 71q-29 29-71 29t-71-29ZM200-80q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-40q0-17 11.5-28.5T280-880q17 0 28.5 11.5T320-840v40h320v-40q0-17 11.5-28.5T680-880q17 0 28.5 11.5T720-840v40h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T760-80H200Zm0-80h560v-400H200v400Z"
                    ></path>
                </svg>

                {post.publishedAt.toLocaleDateString(locale)}
            </time>
            {
                post.category && (
                    <span class="badge badge-ghost bg-base-300 fill-base-content text-base-content text-xs transition-all hover:text-primary hover:fill-primary">
                        {post.category}
                    </span>
                )
            }
        </div>
    </div>
</article>
